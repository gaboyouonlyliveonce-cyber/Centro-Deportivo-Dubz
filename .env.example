# Copia este archivo a .env y reemplaza los valores de ejemplo. NO subas .env a git.

# --- PostgreSQL (usuario maestro) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=centro_deportivo

# --- Neo4j (la contraseña debe tener al menos 8 caracteres) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia_esta_contrasena

# --- Jupyter / PySpark ---
# Carpeta local que se monta como /home/jovyan
PATH_JUPYTER=./notebooks
JUPYTER_TOKEN=cambia_este_token

# --- Databasus (usuario administrador inicial) ---
DATABASUS_NAME=admin
DATABASUS_EMAIL=admin@example.com
DATABASUS_PASSWORD=cambia_esta_contrasena

# --- Usuarios de la Miscelánea III (Sección 1 y Sección 3 ETL) ---
REPORTING_USER_PASSWORD=cambia_esta_contrasena
APP_USER_PASSWORD=cambia_esta_contrasena
POSTGRES_ETL_USER=reporting_user1
POSTGRES_ETL_PASSWORD=cambia_esta_contrasena
POSTGRES_SSLMODE=prefer
DATA_LAKE_LOCAL_PATH=/home/jovyan/data_lake/curated
